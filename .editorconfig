root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{qml,js,json,yaml,yml}]
indent_size = 4

[*.{cpp,h,hpp,c,cc}]
indent_size = 4

[*.{cmake,txt}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
