        Property { name: "model"; type: "QVariant" }
        Property { name: "title"; type: "string" }
        Property { name: "checkedKeys"; type: "QVariant" }
        Property { name: "filterable"; type: "bool" }
        Property { name: "filterMethod"; type: "QVariant" }
        Property { name: "optionDelegate"; type: "QQmlComponent"; isPointer: true }
        Property { name: "footerComponent"; type: "QQmlComponent"; isPointer: true }
        Property { name: "selectedCount"; type: "int"; isReadonly: true }
        Property { name: "availableKeys"; type: "QVariant"; isReadonly: true }
        Property { name: "filteredItems"; type: "QVariant"; isReadonly: true }
        Signal {
            name: "toggled"
            Parameter { name: "key"; type: "QVariant" }
            Parameter { name: "checked"; type: "bool" }
        }
        Signal {
            name: "allToggled"
            Parameter { name: "keys"; type: "QVariant" }
            Parameter { name: "checked"; type: "bool" }
        }
    }
}
